{
  "extends": "@assetval/confs",
  "compilerOptions": {
    "incremental": false,
    "composite": false,
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "inlineSourceMap": false,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "/scripts/greensock/esm/*": ["node_modules/gsap/dist/*"]
    },
    "typeRoots": ["./types", "./node_modules/@types"],
  },
  "include": ["src/**/*.ts", "test/**/*.test.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
