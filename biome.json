{
	"$schema": "https://biomejs.dev/schemas/2.3.1/schema.json",
	"formatter": {
		"enabled": true
	},
	"javascript": {
		"formatter": {
			"indentStyle": "space",
			"quoteStyle": "single",
			"lineWidth": 120
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"noForEach": "off",
				"noThisInStatic": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": [
			"**",
			"!**/node_modules/**",
			"!**/dist/**",
			"!**/coverage/**",
			"!**/.git/**",
			"!**/.github/**",
			"!**/.idea/**",
			"!**/.vscode/**"
		]
	}
}
